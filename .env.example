# Chép thành .env.local rồi điền. KHÔNG commit .env.local.

# Supabase — lấy ở Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khóa service role bỏ qua RLS. Chỉ dùng ở job nền, không bao giờ để lọt ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — model đọc từ cấu hình theo task, không hard-code trong mã (CLAUDE.md).
ANTHROPIC_API_KEY=
